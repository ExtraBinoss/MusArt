{
  "name": "musart-studio",
  "private": true,
  "description": "Open-source local-first creative editor with React Three Fiber, Three.js WebGPURenderer, and TSL.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json",
    "lint:oxlint": "oxlint --type-aware .",
    "lint:react": "eslint . --max-warnings 0",
    "lint": "bun run lint:oxlint && bun run lint:react",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check:rules": "bun scripts/check-rules.ts",
    "check": "bun run check:rules && bun run typecheck && bun run lint && bun run format:check && bun run test:coverage && bun run check:coverage && bun run test:browser && vite build",
    "headless": "bun scripts/headless.ts",
    "check:coverage": "bun scripts/check-rules.ts --coverage",
    "test:segmentation": "bun scripts/verify-segmentation.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "i18next": "26.5.11",
    "idb": "8.0.4",
    "jotai": "3.0.1",
    "lucide-react": "1.62.0",
    "motion": "14.7.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-resizable-panels": "4.15.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@webgpu/types": "0.1.74",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
