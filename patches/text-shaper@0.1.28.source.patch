+function applyPairValue(position: GlyphPosition, value: ValueRecord): void {
+	position.xOffset += value.xPlacement ?? 0;
+	position.yOffset += value.yPlacement ?? 0;
+	position.xAdvance += value.xAdvance ?? 0;
+	position.yAdvance += value.yAdvance ?? 0;
+}
+
+/**
+ * Apply pair records and report zero/no match or the number of consumed glyphs.
+ */
+export function applyPairPosition(
+	lookup: PairPosLookup,
+	firstGlyph: GlyphId,
+	secondGlyph: GlyphId,
+	pos1: GlyphPosition,
+	pos2: GlyphPosition,
+): 0 | 1 | 2 {
+	for (let i = 0; i < lookup.subtables.length; i++) {
+		const subtable = lookup.subtables[i]!;
+		const coverageIndex = subtable.coverage.get(firstGlyph);
+		if (coverageIndex === null) continue;
+
+		if (subtable.format === 1) {
+			const pairSet = subtable.pairSets[coverageIndex];
+			if (!pairSet) continue;
+
+			const record = findPairValueRecord(pairSet.pairValueRecords, secondGlyph);
+			if (record) {
+				applyPairValue(pos1, record.value1);
+				applyPairValue(pos2, record.value2);
+				return subtable.valueFormat2 === 0 ? 1 : 2;
+			}
+		} else if (subtable.format === 2) {
+			const class1 = subtable.classDef1.get(firstGlyph);
+			// Early bounds check before array access
+			const class1Records = subtable.class1Records;
+			if (class1 >= class1Records.length) continue;
+
+			const class1Record = class1Records[class1]!;
+			const class2 = subtable.classDef2.get(secondGlyph);
+			const class2Records = class1Record.class2Records;
+			if (class2 >= class2Records.length) continue;
+
+			const class2Record = class2Records[class2]!;
+			applyPairValue(pos1, class2Record.value1);
+			applyPairValue(pos2, class2Record.value2);
+			return subtable.valueFormat2 === 0 ? 1 : 2;
+		}
+	}
+
+	return 0;
+}
