{
  "objective": "Deliver eleven adjustable procedural TSL effects in the editor, with genuine image-based visual verification and consistent preview/export rendering.",
  "architecture": {
    "core": "Portable definitions, validated settings and commands only; no DOM or GPU resources.",
    "render": "One effect-owned directory per Three.js TSL implementation; shared authored 1x reference and GPU mip transport.",
    "web": "Registry-driven English/French controls and editable center/radius overlays using imperative previews, cancellation and one undo entry.",
    "clock": "Explicit deterministic effect time; live playback must stop and release resources, and export must use the displayed phase.",
    "verification": "Heavy checks and native browser cohorts run serially with bounded workers and memory. Captures/reports/original test photos remain in ignored artifacts."
  },
  "perEffectChecklist": [
    "Choose and record real visual references and primary algorithm references.",
    "Define a distinctive, useful default appearance and all meaningful bounded parameters.",
    "Implement pure core metadata and strict imported-setting validation.",
    "Implement the GPU graph in the effect's own directory with stable mutable uniforms.",
    "Add exact mirrored tests for executable source, including defaults, boundaries and error paths.",
    "Register the effect in creation, search, menus, translations, serialization and editing commands.",
    "Render a real photograph, inspect a native PNG and compare the result to the chosen visual references.",
    "Verify actual WebGPU and Three's WebGL fallback; do not count an unavailable backend as passed.",
    "Check source alpha, working color space, masks/groups, deterministic seeds and extreme settings.",
    "Verify zoom and export sampling use the same authored effect reference.",
    "For spatial effects, verify center/radius handles under nested transforms, cancellation and one-entry undo/redo.",
    "For animated effects, verify explicit phase, playback cleanup and displayed-phase export.",
